* --- Amac fonksiyonu agirliklari ---
Scalar
alpha   "Makespan agirligi"          / 0.10 /
beta    "Agirlikli gecikme agirligi" / 0.60 /
gamma_p "Geciken is sayisi agirligi" / 0.30 /
BigM    "Big-M sabiti"               / 9999999 /
;

* --- Rota-makine kullanim matrisi ---
Parameter ar(r,j) "Rota r makine j kullaniyor mu (0/1)" ;
ar(r,j) = 0 ;

ar("r1","Bielom2")    = 1 ; ar("r1","Shrink1")    = 1 ; ar("r1","MSK") = 1 ;

ar("r2","Bielom1")    = 1 ; ar("r2","PolarBicak") = 1 ;
ar("r2","Kugler")     = 1 ; ar("r2","Plasticol")  = 1 ;
ar("r2","Shrink2")    = 1 ; ar("r2","MSK")        = 1 ;

ar("r3","Bielom1")    = 1 ; ar("r3","PolarBicak") = 1 ;
ar("r3","Kore")       = 1 ; ar("r3","Shrink2")    = 1 ;
ar("r3","MSK")        = 1 ;

ar("r4","Bielom1")    = 1 ; ar("r4","PolarBicak") = 1 ;
ar("r4","Kugler")     = 1 ; ar("r4","Autobind")   = 1 ;
ar("r4","Shrink2")    = 1 ; ar("r4","MSK")        = 1 ;

ar("r5","Bielom1")    = 1 ; ar("r5","PolarBicak") = 1 ;
ar("r5","CWH")        = 1 ; ar("r5","Shrink2")    = 1 ;
ar("r5","MSK")        = 1 ;

ar("r6","Bielom1")    = 1 ; ar("r6","PolarBicak") = 1 ;
ar("r6","Kugler")     = 1 ; ar("r6","ManSpiral")  = 1 ;
ar("r6","Shrink2")    = 1 ; ar("r6","MSK")        = 1 ;

ar("r7","Bielom1")    = 1 ; ar("r7","PolarBicak") = 1 ;
ar("r7","Juki")       = 1 ; ar("r7","Shrink2")    = 1 ;
ar("r7","MSK")        = 1 ;

* --- Rota icinde makine islem sirasi ---
Parameter seq(r,j) "Rota r icinde makine j nin islem sirasi (0=kullanilmiyor)" ;
seq(r,j) = 0 ;

seq("r1","Bielom2")    = 1 ; seq("r1","Shrink1")    = 2 ; seq("r1","MSK")      = 3 ;

seq("r2","Bielom1")    = 1 ; seq("r2","PolarBicak") = 2 ; seq("r2","Kugler")   = 3 ;
seq("r2","Plasticol")  = 4 ; seq("r2","Shrink2")    = 5 ; seq("r2","MSK")      = 6 ;

seq("r3","Bielom1")    = 1 ; seq("r3","PolarBicak") = 2 ; seq("r3","Kore")     = 3 ;
seq("r3","Shrink2")    = 4 ; seq("r3","MSK")        = 5 ;

seq("r4","Bielom1")    = 1 ; seq("r4","PolarBicak") = 2 ; seq("r4","Kugler")   = 3 ;
seq("r4","Autobind")   = 4 ; seq("r4","Shrink2")    = 5 ; seq("r4","MSK")      = 6 ;

seq("r5","Bielom1")    = 1 ; seq("r5","PolarBicak") = 2 ; seq("r5","CWH")      = 3 ;
seq("r5","Shrink2")    = 4 ; seq("r5","MSK")        = 5 ;

seq("r6","Bielom1")    = 1 ; seq("r6","PolarBicak") = 2 ; seq("r6","Kugler")   = 3 ;
seq("r6","ManSpiral")  = 4 ; seq("r6","Shrink2")    = 5 ; seq("r6","MSK")      = 6 ;

seq("r7","Bielom1")    = 1 ; seq("r7","PolarBicak") = 2 ; seq("r7","Juki")     = 3 ;
seq("r7","Shrink2")    = 4 ; seq("r7","MSK")        = 5 ;

* --- Urun-rota uyumlulugu ---
Parameter compati(i,r) "Is i rota r ile uyumlu mu (0/1)" ;
compati(i,r) = 0 ;

compati(i,"r1")$(i_TelDikis(i))      = 1 ;
compati(i,"r2")$(i_PlastikStd(i))    = 1 ;
compati(i,"r3")$(i_PlastikStd(i))    = 1 ;
compati(i,"r2")$(i_PlastikKucuk(i))  = 1 ;
compati(i,"r3")$(i_PlastikKucuk(i))  = 1 ;
compati(i,"r4")$(i_DblMetalKucuk(i)) = 1 ;
compati(i,"r5")$(i_DblMetalKucuk(i)) = 1 ;
compati(i,"r4")$(i_DblMetalBuyuk(i)) = 1 ;
compati(i,"r5")$(i_DblMetalBuyuk(i)) = 1 ;
compati(i,"r6")$(i_ManuelSpiral(i))  = 1 ;
compati(i,"r7")$(i_IplikDikis(i))    = 1 ;

* --- Rota bazli darbogaz makineleri ---
* r1->Bielom2  r2->Plasticol  r3->Kore
* r4->Autobind r5->CWH        r6->ManSpiral  r7->Juki
* Diger makineler (Bielom1, PolarBicak, Kugler, Shrink1/2, MSK) %10 sure alir.

Parameter darbogaz(r,j) "Rota r icin makine j darbogaz mi (1=evet 0=hayir)" ;
darbogaz(r,j) = 0 ;
darbogaz("r1","Bielom2")   = 1 ;
darbogaz("r2","Plasticol") = 1 ;
darbogaz("r3","Kore")      = 1 ;
darbogaz("r4","Autobind")  = 1 ;
darbogaz("r5","CWH")       = 1 ;
darbogaz("r6","ManSpiral") = 1 ;
darbogaz("r7","Juki")      = 1 ;

* --- p(i,r,j): Rota bazli isleme suresi ---
* Darbogaz makine: tam sure (p_rota / 60 dk/adet)
* Diger makineler: %10 sure (10x daha hizli - destek islemi)
Parameter p(i,r,j) "Is i rota r ile ataninca makine j isleme suresi (dk/adet)" ;
p(i,r,j) = 0 ;
p(i,r,j)$(compati(i,r) gt 0 and ar(r,j) gt 0 and darbogaz(r,j) gt 0) =
    p_rota(i,r) / 60 ;
p(i,r,j)$(compati(i,r) gt 0 and ar(r,j) gt 0 and darbogaz(r,j) eq 0) =
    p_rota(i,r) / 60 * 0.25 ;

* --- p_ij: is i herhangi bir rotada makine j kullaniyorsa filtre ---
Parameter p_ij(i,j) "Is i icin makine j herhangibir rotada kullaniliyor mu" ;
p_ij(i,j) = 0 ;
p_ij(i,j) = sum(r$(compati(i,r) gt 0 and ar(r,j) gt 0 and p_rota(i,r) gt 0), 1) ;

Parameter s(i,ii,j) "Is i'den is ii'ye makine j setup suresi (dk)" ;
s(i,ii,j) = 0 ;

s(i,ii,"Bielom1")$(i_cizgili(i) and i_kareli(ii))  = 40 ;
s(i,ii,"Bielom2")$(i_cizgili(i) and i_kareli(ii))  = 40 ;
s(i,ii,"Bielom1")$(i_kareli(i)  and i_cizgili(ii)) = 40 ;
s(i,ii,"Bielom2")$(i_kareli(i)  and i_cizgili(ii)) = 40 ;
s(i,ii,"Bielom1")$(i_cizgili(i) and i_duz(ii))     = 40 ;
s(i,ii,"Bielom2")$(i_cizgili(i) and i_duz(ii))     = 40 ;
s(i,ii,"Bielom1")$(i_duz(i)     and i_cizgili(ii)) = 40 ;
s(i,ii,"Bielom2")$(i_duz(i)     and i_cizgili(ii)) = 40 ;
s(i,ii,"Bielom1")$(i_kareli(i)  and i_duz(ii))     = 40 ;
s(i,ii,"Bielom2")$(i_kareli(i)  and i_duz(ii))     = 40 ;
s(i,ii,"Bielom1")$(i_duz(i)     and i_kareli(ii))  = 40 ;
s(i,ii,"Bielom2")$(i_duz(i)     and i_kareli(ii))  = 40 ;



* ============================================================
* DEGISKENLER
* ============================================================

* --- Cakisan is cifti filtresi (K5 kisit sayisini azaltir) ---
Parameter pairij(i,ii,j) "Is i ve ii ayni makinede cakisabilir mi" ;
pairij(i,ii,j) = 0 ;
pairij(i,ii,j)$(ord(i) lt ord(ii)) =
  sum(r$(compati(i,r) gt 0 and ar(r,j) gt 0), 1) *
  sum(r$(compati(ii,r) gt 0 and ar(r,j) gt 0), 1) ;

Binary Variables
x(i,r)    "Is i rota r ye atanirsa 1"
delta(i)  "Is i teslim tarihini asiyorsa 1"
;

Binary Variable z(i,ii,j) "Makine j de is i is ii den once isleniyor" ;
z.fx(i,ii,j)$(pairij(i,ii,j) eq 0) = 0 ;

Positive Variables
y(i,j)    "Is i makine j de isleniyor (K2 ile belirlenir)"
C(i,j)    "Is i makine j tamamlanma zamani (dk)"
Ci(i)     "Is i son tamamlanma zamani (dk)"
Ti(i)     "Is i gecikme miktari (dk)"
Cmax      "Makespan - en gec tamamlanma (dk)"
;

Free Variable Z_obj "Amac fonksiyonu" ;

Scalar Cmax_UB "C degiskenleri icin makul ust sinir (dk)" / 2500000 / ;
y.up(i,j)  = 1 ;
C.up(i,j)  = Cmax_UB ;
Ci.up(i)   = Cmax_UB ;
Cmax.up    = Cmax_UB ;
x.lo(i,r)$(compati(i,r) eq 0) = 0 ;
x.up(i,r)$(compati(i,r) eq 0) = 0 ;

* ============================================================
* DENKLEMLER
* ============================================================

Equations
def_obj        "Amac fonksiyonu"
K1(i)          "Her is tam olarak bir rotaya atanir"
K2(i,j)        "Rota-makine tutarliligi"
K4(i,j)        "Tamamlanma suresi tanimi"
K5a(i,ii,j)    "Disjunctive kisit - is i once"
K5b(i,ii,j)    "Disjunctive kisit - is ii once"
K6a(i,j)       "Ci >= C(i,j)"
K6b(i)         "Cmax >= Ci"
K7a(i)         "Gecikme tanimi"
K7b(i)         "Gecikme bayrak"
K8(i,r,j,jj)  "Rota icinde ardisik makine sirasi kisiti"
;

def_obj ..
  Z_obj =E=
    alpha   * Cmax
  + beta    * sum(i, Ti(i))
  + gamma_p * sum(i, delta(i)) ;

K1(i)$(qty(i) gt 0) ..
  sum(r$(compati(i,r) gt 0), x(i,r)) =E= 1 ;

K2(i,j)$(sum(r$(compati(i,r) gt 0 and ar(r,j) gt 0), 1) gt 0) ..
  y(i,j) =E= sum(r$(ar(r,j) eq 1 and compati(i,r) eq 1), x(i,r)) ;

K4(i,j)$(p_ij(i,j) gt 0) ..
  C(i,j) =G= sum(r$(compati(i,r) gt 0 and ar(r,j) gt 0),
               p(i,r,j) * qty(i) * x(i,r)) ;

K5a(i,ii,j)$(pairij(i,ii,j) gt 0) ..
  C(i,j) =G= C(ii,j)
             + sum(r$(compati(i,r) gt 0 and ar(r,j) gt 0), p(i,r,j) * qty(i) * x(i,r))
             + sum(r$(compati(ii,r) gt 0 and ar(r,j) gt 0), s(ii,i,j))
             - BigM * (1 - z(i,ii,j)) ;

K5b(i,ii,j)$(pairij(i,ii,j) gt 0) ..
  C(ii,j) =G= C(i,j)
              + sum(r$(compati(ii,r) gt 0 and ar(r,j) gt 0), p(ii,r,j) * qty(ii) * x(ii,r))
              + sum(r$(compati(i,r) gt 0 and ar(r,j) gt 0), s(i,ii,j))
              - BigM * z(i,ii,j) ;

K6a(i,j)$(p_ij(i,j) gt 0) ..  Ci(i) =G= C(i,j) ;
K6b(i) ..                  Cmax  =G= Ci(i) ;

K7a(i) ..  Ti(i)    =G= Ci(i) - d(i) ;
K7b(i) ..  delta(i) =G= (Ci(i) - d(i)) / BigM ;

* K8: Rota icinde ardisik makine sirasi - onceki makine bitmeden sonraki baslayamaz
K8(i,r,j,jj)$(
    compati(i,r) gt 0
    and ar(r,j) gt 0 and ar(r,jj) gt 0
    and seq(r,jj) eq seq(r,j) + 1
) ..
    C(i,jj) =G= C(i,j) + p(i,r,j) * qty(i) * x(i,r) ;

* ============================================================
* MODEL VE COZUCU
* ============================================================

$onecho > cplex.opt
threads 4
mipemphasis 1
varsel 4
nodesel 2
cutpass 10
epgap 0.10
tilim 3600
heurfreq 10
fpheur 1
$offecho

Model pilot_model /
  def_obj K1 K2 K4 K5a K5b K6a K6b K7a K7b K8
/ ;

pilot_model.optfile = 1 ;

Option
  MIP    = CPLEX
  optcr  = 0.05
  reslim = 7200
  solprint = on
  limrow = 0
  limcol = 0
;

Solve pilot_model using MIP minimizing Z_obj ;

* ============================================================
* CIKIS RAPORU
* ============================================================

Parameter
  rota_atama(i)     "Is i atandigi rota (1-7)"
  tamamlanma(i)     "Is i son tamamlanma (dk)"
  gecikme(i)        "Is i gecikme miktari (dk)"
  gecikme_gun(i)    "Is i gecikme (gun)"
  teslim_gun(i)     "Is i tamamlanma (gun)"
  makine_yuk(j)     "Makine j toplam yuklenme (dk)"
  makine_yuk_gun(j) "Makine j toplam yuklenme (gun)"
;

rota_atama(i)     = sum(r$(x.l(i,r) gt 0.5), ord(r)) ;
tamamlanma(i)     = Ci.l(i) ;
gecikme(i)        = Ti.l(i) ;
gecikme_gun(i)    = Ti.l(i) / 1200 ;
teslim_gun(i)     = Ci.l(i) / 1200 ;
makine_yuk(j)     = sum(i$(p_ij(i,j) gt 0), sum(r$(compati(i,r) gt 0 and ar(r,j) gt 0 and x.l(i,r) gt 0.5), p(i,r,j) * qty(i))) ;
makine_yuk_gun(j) = makine_yuk(j) / 1200 ;

Scalar geciken_is_adedi ;
geciken_is_adedi = sum(i$(Ti.l(i) gt 0.01), 1) ;

Display
  Z_obj.l, Cmax.l,
  rota_atama,
  tamamlanma,
  teslim_gun,
  gecikme,
  gecikme_gun,
  makine_yuk,
  makine_yuk_gun,
  geciken_is_adedi,
  d;
