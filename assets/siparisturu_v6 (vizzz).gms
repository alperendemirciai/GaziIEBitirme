* istur(i,t): alt setlerden turetilir - Parameter olarak tanimlandi (GAMS uyumlulugu)
Parameter istur(i,t) "Siparis i tur t'ye ait mi (1=evet, 0=hayir)" ;
istur(i,"T_TelDikis_Std")        = i_TelDikis(i) ;
istur(i,"T_PlastikSpiral_Std")   = i_PlastikStd(i) ;
istur(i,"T_PlastikSpiral_Kucuk") = i_PlastikKucuk(i) ;
istur(i,"T_DblMetal_Kucuk")      = i_DblMetalKucuk(i) ;
istur(i,"T_DblMetal_Buyuk")      = i_DblMetalBuyuk(i) ;
istur(i,"T_ManuelSpiral")        = i_ManuelSpiral(i) ;
istur(i,"T_IplikDikis")          = i_IplikDikis(i) ;


* ============================================================
* p_rota: Siparis-rota isleme suresi - TURDEN TURETILIR
* p_rota(i,r) = sum(t, istur(i,t) * p_rota_tur(t,r))
* ============================================================
Parameter p_rota(i,r) "Is i rota r isleme suresi (sn/adet) - turden turetilir" ;
p_rota(i,r) = 0 ;
p_rota(i,r) = sum(t$(istur(i,t) gt 0), p_rota_tur(t,r)) ;


