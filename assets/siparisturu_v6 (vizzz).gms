* ============================================================
* URUN TURLERI
* Tanimlanma mantigi: CiltTipi-Format-SayfaSayisi
* Her tur, ayni isleme suresine (p_rota_tur) sahip urun grubunu temsil eder.
* ============================================================
t  urunturu /
* --- Tel Dikiş (r1 rotasi, 2 sn/adet) ---
T_TelDikis_Std        "Tel Dikiş - Standart (r1: 2 sn)"

* --- Plastik Spiral - Standart A serisi/benzer (r2:15 / r3:16.5 sn) ---
T_PlastikSpiral_Std   "Plastik Spiral - Standart (r2:15 / r3:16.5 sn)"

* --- Plastik Spiral - Küçük format / az yaprak (r2:10 / r3:11.5 sn) ---
T_PlastikSpiral_Kucuk "Plastik Spiral - Küçük Format (r2:10 / r3:11.5 sn)"

* --- Double Metal Spiral - Küçük (r4:9 / r5:15 sn) ---
T_DblMetal_Kucuk      "Double Metal Spiral - Küçük (r4:9 / r5:15 sn)"

* --- Double Metal Spiral - Büyük (r4:17 / r5:23 sn) ---
T_DblMetal_Buyuk      "Double Metal Spiral - Büyük (r4:17 / r5:23 sn)"

* --- Manuel Spiral (r6:17 sn) ---
T_ManuelSpiral        "Manuel Spiral (r6: 17 sn)"

* --- İplik Dikiş (r7:15 sn) ---
T_IplikDikis          "İplik Dikiş (r7: 15 sn)"
/
;

Alias(i,ii) ;
Alias(j,jj) ;


* ============================================================
* URUN TURLERI - ISLEME SURESI PARAMETRESI
* p_rota_tur(t,r): tur t'nin rota r'deki isleme suresi (sn/adet)
* ============================================================
Parameter p_rota_tur(t,r) "Tur t rota r isleme suresi (sn/adet)" ;
p_rota_tur(t,r) = 0 ;


* Tel Dikiş Standart: sadece r1
p_rota_tur("T_TelDikis_Std",   "r1") = 2 ;

* Plastik Spiral Standart: r2 ve r3
p_rota_tur("T_PlastikSpiral_Std",  "r2") = 15 ;
p_rota_tur("T_PlastikSpiral_Std",  "r3") = 16.5 ;

* Plastik Spiral Küçük Format: r2 ve r3
p_rota_tur("T_PlastikSpiral_Kucuk","r2") = 10 ;
p_rota_tur("T_PlastikSpiral_Kucuk","r3") = 11.5 ;

* Double Metal Spiral Küçük (20YP / A6 benzeri): r4 ve r5
p_rota_tur("T_DblMetal_Kucuk",    "r4") = 9 ;
p_rota_tur("T_DblMetal_Kucuk",    "r5") = 15 ;

* Double Metal Spiral Büyük (100YP 17x24, 70YP küçük defter): r4 ve r5
p_rota_tur("T_DblMetal_Buyuk",    "r4") = 17 ;
p_rota_tur("T_DblMetal_Buyuk",    "r5") = 23 ;

* Manuel Spiral: r6
p_rota_tur("T_ManuelSpiral",      "r6") = 17 ;

* İplik Dikiş: r7
p_rota_tur("T_IplikDikis",        "r7") = 15 ;


